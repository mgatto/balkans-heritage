{
  "author": "Michael Gatto <gatto_omar@hotmail.com>",
  "bugs": {
    "url": "https://github.com/mgatto/balkans-heritage/issues"
  },
  "description": "",
  "engines": {
    "node": "22.14.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^10.9.0",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.4.0",
    "rdfa-streaming-parser": "^3.0.2",
    "rollup": "^4.62.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.1",
    "vite-plugin-minify": "^3.0.0"
  },
  "homepage": "https://github.com/mgatto/balkans-heritage#readme",
  "license": "MIT",
  "main": "index.html",
  "name": "balkans-heritage",
  "repository": {
    "type": "git",
    "url": "git+https://mgatto@github.com/mgatto/balkans-heritage.git"
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "npm run lighthouse",
    "dev": "vite",
    "lighthouse": "npm run lighthouse:desktop && npm run lighthouse:mobile",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.cjs",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "lint": "npx lint-staged",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "lint:js": "eslint \"src/**/*.{js,mjs,cjs,json,jsonc,json5}\"",
    "lint:js:fix": "eslint --fix \"src/**/*.{js,mjs,cjs,json,jsonc,json5}\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "validate:rdfa": "node scripts/validate-rdfa.mjs",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "version": "1.1.0"
}
