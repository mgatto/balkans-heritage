    "puppeteer": "^24.43.1",
    "rdfa-streaming-parser": "^3.0.2",
    "rollup": "^4.63.1",
    "sass": "^1.104.0",
    "selenium-webdriver": "^4.47.0",
    "sitemap": "^9.0.1",
    "start-server-and-test": "^3.0.12",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "vite": "^8.2.1",
    "vite-plugin-minify": "^3.0.0",
    "vitest": "^4.1.10",
    "web-features": "^3.37.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": "24.20.0"
  },
  "homepage": "https://github.com/mgatto/balkans-heritage#readme",
  "license": "MIT",
  "main": "index.html",
  "name": "balkans-heritage",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://mgatto@github.com/mgatto/balkans-heritage.git"
  },
  "scripts": {
    "a11y": "start-server-and-test preview:test http://localhost:4173 a11y:scan",
    "a11y:scan": "node scripts/a11y.mjs",
    "bs:browsers": "node --env-file-if-exists=.env scripts/browserstack-screenshots.mjs --list",
    "bs:screenshots": "node --env-file-if-exists=.env scripts/browserstack-screenshots.mjs",
    "bs:screenshots:local": "vite build && node --env-file-if-exists=.env scripts/browserstack-screenshots.mjs --local",
    "build": "vite build",
    "build:preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite",
    "intel:browser-features": "node scripts/browser-feature-intel.mjs",
    "intel:bugs": "node scripts/browser-bugs.mjs --feature",
    "intel:bugs:all": "node scripts/browser-bugs.mjs",
    "intel:query": "node scripts/browser-feature-intel.mjs --query",
    "lighthouse": "npm run lighthouse:desktop && npm run lighthouse:mobile",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.cjs",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "lint": "npx lint-staged",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.{js,mjs,cjs,json,jsonc,json5}\" \"scripts/**/*.{js,mjs,cjs}\" \"vitest.config.mjs\"",
    "lint:js:fix": "eslint --fix \"src/**/*.{js,mjs,cjs,json,jsonc,json5}\" \"scripts/**/*.{js,mjs,cjs}\" \"vitest.config.mjs\"",
    "postbuild": "npm run lighthouse && npm run a11y",
    "prepare": "husky",
    "preview": "vite preview",
    "preview:test": "vite preview --port 4173 --strictPort",
    "release": "commit-and-tag-version",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:rdfa": "node scripts/validate-rdfa.mjs"
  },
  "type": "module",
  "version": "2.4.0",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "workerd@1.20260903.1": true,
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
