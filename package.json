    "browserslist": "^4.28.9",
    "browserslist-to-esbuild": "^2.1.1",
    "browserstack-local": "^1.5.13",
    "caniuse-lite": "^1.0.30001809",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-compat": "^7.0.2",
    "feed": "^6.0.0",
    "globals": "^17.12.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^10.17.0",
    "htmlparser2": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "lightningcss": "^1.33.0",
