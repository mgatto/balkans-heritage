{
    "$schema": "https://opencode.ai/config.json",
    "lsp": {
        "css-lsp": {
            "command": [
                "vscode-css-language-server",
                "--stdio"
            ],
            "extensions": [
                ".css",
                ".scss",
                ".less"
            ],
            "initialization": {
                "provideFormatter": true
            }
        },
        "html-server": {
            "command": [
                "vscode-html-language-server",
                "--stdio"
            ],
            "extensions": [
                ".html",
                ".htm"
            ]
        }
    }
}
