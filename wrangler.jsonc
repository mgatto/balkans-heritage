{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "compatibility_date": "2026-09-03",
  "name": "balkans-heritage",
  "routes": [
    {
      "custom_domain": true,
      "pattern": "balkanheritage.info"
    }
  ]
}